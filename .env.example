# TenantSage Documentation Portal — Environment Variables
# Copy to .env.local for local development
# Production values are stored as GitHub Actions secrets

# ── Notion Integration ──────────────────────────────────────
# Set in GitHub Actions secrets: Settings > Secrets and variables > Actions
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_WORKSPACE_ID=bdcb72de-b8fb-8101-9c0f-0003c3fbb854

# ── Notion Database IDs (set as Repository Variables, not Secrets) ──
# Find these in your Notion database URLs: notion.so/workspace/{DATABASE_ID}?v=...
# Settings > Secrets and variables > Actions > Variables tab
NOTION_DB_PLATFORM=
NOTION_DB_GOVERNANCE=
NOTION_DB_TECHNOLOGY=
NOTION_DB_DEVELOPERS=
NOTION_DB_RESOURCES=

# ── Cloudflare Pages ─────────────────────────────────────────
# Set in GitHub Actions secrets
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Local Development ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
